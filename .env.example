# SIH 2026 Societal Innovation Collaboration Portal - Environment Variables

# Application
PROJECT_NAME="SIH 2026 Societal Innovation Collaboration Portal"
ORGANIZATION="Government of Jharkhand - Higher & Technical Education"
SECRET_KEY="replace-with-a-random-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Defaults to SQLite for instant local execution:
DATABASE_URL="sqlite:///./sih_jharkhand.db"
# For Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih_portal"

# Storage Configuration
# 'local' saves files in ./uploads folder; 's3' uploads to AWS S3 bucket
STORAGE_TYPE="local"
UPLOAD_DIR="uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="jharkhand-sih-challenges"

# Optional Pluggable LLM APIs
GEMINI_API_KEY=""
OPENAI_API_KEY=""
