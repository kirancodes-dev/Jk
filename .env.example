# SIH 2026 Societal Innovation Collaboration Portal - Environment Variables Template
# Copy to .env for local development: cp .env.example .env

# Environment Mode: 'development', 'test', or 'production'
ENVIRONMENT="development"

# Application Metadata
PROJECT_NAME="SIH 2026 Societal Innovation Collaboration Portal"
ORGANIZATION="Government of Jharkhand - Higher & Technical Education"

# Security: In production, generate with `openssl rand -hex 32` (min 32 chars).
# Production startup fails closed if using default/placeholder or <32 chars.
SECRET_KEY="dev-insecure-secret-key-32chars-minimum-length-for-local-testing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (comma-separated). Wildcard '*' is prohibited when ENVIRONMENT=production.
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://localhost:8008,http://127.0.0.1:3000,http://127.0.0.1:8008"

# Database Configuration
# Local Development default (SQLite):
DATABASE_URL="sqlite:///./sih_jharkhand.db"
# Production Target (PostgreSQL - SQLite is strictly rejected in production):
# DATABASE_URL="postgresql://sih_user:your_secure_password@localhost:5432/sih_jharkhand"

# Media Storage Configuration ('local' or 's3')
STORAGE_TYPE="local"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_BYTES=15728640

# AWS S3 Settings (Required if STORAGE_TYPE="s3" in production)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="jharkhand-sih-challenges"

# Optional Pluggable LLM APIs
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@jharkhand.gov.in"
SMTP_FROM_NAME="Government of Jharkhand Innovation Council"

